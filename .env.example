PORT=3000
NODE_ENV=development
# Configuração de IA (Groq)
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Mercado Pago em teste: use contas e cartões de teste, nunca dados de clientes reais.
MERCADOPAGO_MODE=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL HTTPS pública necessária para receber webhooks. Não é criada automaticamente.
APP_URL=
# false permite validar toda a operação local sem pagamento; não é assinatura paga.
BILLING_ENFORCE=false
LOCAL_PLAN=avancado
# Opcional: substituir catálogo. Formato documentado em docs/OPERATIONS.md.
# BILLING_PLANS_JSON=[]
# Em produção, configure uma chave base64 de 32 bytes e preserve-a no backup.
# EQUILIBRA_DATA_KEY=
